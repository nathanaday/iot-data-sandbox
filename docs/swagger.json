                "summary": "Delete a datasource",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Datasource ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "400": {
                        "description": "Bad Request",
